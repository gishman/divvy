{
  "name": "@divvy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "db:local": "node --env-file-if-exists=.env scripts/dev-db.js"
  },
  "dependencies": {
    "@divvy/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.0.0-beta.0"
  }
}
