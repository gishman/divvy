# ---- Database -------------------------------------------------------------
# Point this at your local PostgreSQL (13+). Create the database first:
#   createdb divvy      (or: CREATE DATABASE divvy; in psql / pgAdmin)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/divvy

# ---- Server ---------------------------------------------------------------
PORT=4000
# Comma separated list of allowed browser origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
# CHANGE THIS in any shared/production environment
JWT_SECRET=dev-only-change-me
NODE_ENV=development

# ---- Verification codes ---------------------------------------------------
# Providers: console (default; codes are printed to the server log and
# echoed to the UI in development), twilio, sendgrid, smtp
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SendGrid (email)
SENDGRID_API_KEY=
EMAIL_FROM=divvy <no-reply@divvy.local>

# SMTP (email) — used when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- PayPal Business --------------------------------------------------------
# Set PAYPAL_MODE to 'sandbox' for testing, or 'live' for production
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
